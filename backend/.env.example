#############################
# Backend environment sample #
#############################

# Port the Express server listens on
PORT=5000

# Set to production in live environments
NODE_ENV=development

# Your MongoDB connection string (do NOT commit the real value)
# Examples:
# - Local: mongodb://localhost:27017/safetyc
# - Atlas: mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@clustersafetyc.snrwfqh.mongodb.net/databasename

# Comma-separated list of allowed origins for CORS
# Example (dev): http://localhost:5173
# Example (prod): https://www.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# Email Configuration (Nodemailer)
# Use your SMTP credentials (e.g., Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Safetyc <noreply@safetyc.in>"
